# Copy this file to .env and fill in your values

# Server (for QR links and check-in URL)
BASE_URL=http://localhost:3001
# PORT=3001
# NODE_ENV=production

# Supabase (required for auth, events, bookings, attendees, scanners)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key
# Optional: Storage bucket name for profile photos (public bucket). Default: avatars
# SUPABASE_AVATARS_BUCKET=avatars

# Auth (session JWT for logged-in users — use a long random string in production)
JWT_SECRET=YOUR_JWT_SECRET
# Optional: separate secret for scanner session tokens (defaults to JWT_SECRET)
# SCANNER_JWT_SECRET=

# Google OAuth ("Sign in with Google")
GOOGLE_OAUTH_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_OAUTH_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Staff/scanner API (protects scanning endpoints)
SCANNER_API_KEY=YOUR_SCANNER_API_KEY

# Google Sheet (optional legacy path; many flows use Supabase only)
GOOGLE_SHEET_ID=your_sheet_id_here
GOOGLE_SERVICE_ACCOUNT_JSON=path/to/service-account.json

# Email (Gmail example — App Password, not your normal password)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_APP_PASSWORD=your-16-char-app-password

EVENT_NAME=My Awesome Event

# If a Supabase Edge Function sends ticket email instead of Node:
# EMAIL_VIA_SUPABASE=true

# Admin dashboard + /api/admin/*
ADMIN_API_KEY=YOUR_ADMIN_API_KEY
